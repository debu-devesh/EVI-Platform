# EVI Environment Variables
# Copy this file to .env and update with your values

# Flask Secret Key (required for production)
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=   # optional: leave unset for a random key per start; set a fixed one in production

# Development Mode (set to True to bypass authentication)
# WARNING: Only use True for development/testing
DEV_MODE=False

# LM Studio Configuration (optional)
# If using LM Studio for AI chat, configure these:
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=your-model-name

# Database Paths (optional - defaults are used if not set)
# AUTH_DB_PATH=path/to/authentication/database
# SESSION_DB_PATH=path/to/session/database

# Logging Level (optional)
# LOG_LEVEL=INFO

# Query feedback learning (optional — defaults under FORENSIC/data/; files are gitignored)
# EVI_QUERY_FEEDBACK_PATH=path/to/query_feedback.jsonl
# EVI_QUERY_POLICY_MEMORY_PATH=path/to/query_policy_memory.json

# OpenRouter (used by the Docker quickstart for LLM calls)
# Get a key at https://openrouter.ai/keys, set a credit limit on it
OPENROUTER_API_KEY=your-openrouter-key-here
LLM_OPENROUTER_MODEL=openrouter/free

# OpenRouter (LLM calls)
OPENROUTER_API_KEY=your-openrouter-key-here
LLM_OPENROUTER_MODEL=openrouter/free
